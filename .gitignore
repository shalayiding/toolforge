# Virtual environment (uv creates .venv)
.venv/
venv/

# temp/ — legacy location, no longer used
temp/

# community/ cloned source subdirs — kept locally for reference, not tracked in git
# (nested .git dirs are already ignored by git, but explicit globs catch non-git clones)
community/*/

# Vector DB and runtime registry (regenerated by seed_registry.py)
registry/chroma_db/
registry/tool_registry.json
registry/__pycache__/

# Machine-specific MCP config (generated by setup_mcp.py)
.mcp.json

# seeds.json and tool wrappers are user-maintained, not part of the framework
registry/seeds.json

# Personal tool dependencies (user-maintained, not part of the framework)
requirements.local.txt

# uv lockfile — let each user resolve latest versions
uv.lock

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Environment variables
.env
.env.*

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Claude memory (personal)
memory/

# Tool output directory
output/
